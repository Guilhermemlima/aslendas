# ---------------------------------------------------------------------------
# Público (pode ir para o browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# ---------------------------------------------------------------------------
# Somente servidor. NUNCA prefixar com NEXT_PUBLIC_.
# Usada apenas em rotas /api e Server Actions (exportação, cron de surpresas).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=ey...

# Segredo do endpoint de cron (Vercel Cron -> /api/cron/surprises)
CRON_SECRET=troque-por-um-valor-aleatorio-longo

# URL pública do app (usada em e-mails de convite do Supabase Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
